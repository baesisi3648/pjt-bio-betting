{
  // 와일드 더비 — Cloudflare Worker + Durable Objects
  //
  // ⚠️ 판 코드 하나 = GameRoom 인스턴스 하나 (idFromName(code)).
  //    이 대응을 깨면 한 판의 상태가 여러 인스턴스로 흩어지고,
  //    DO 가 공짜로 주던 직렬화(= 예전의 LockService)가 사라진다 (MIGRATION §4-7).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wilde-derby",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-05",

  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },

  // SQLite 기반 DO. 무료 플랜에서 쓸 수 있는 쪽이고, storage API 는 그대로다
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  // 판 **사이에서** 공유되는 데이터 — 문제은행·동물·설정·'이어하기' 목록.
  // 판 하나의 상태는 여기 없다. 그건 Durable Object 에 있다 (MIGRATION §6 대응표).
  //
  // database_id 는 2026-09-05 배포 때 scripts/deploy.sh 가 채웠다 (계정 baesisi3648).
  // 다른 계정으로 새로 배포하면 스크립트가 그 계정의 D1 을 만들어 다시 채운다.
  //    (로컬은 npx wrangler d1 migrations apply wilde-derby --local)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wilde-derby",
      "database_id": "f6a609f6-4a53-4382-9773-0a12bb0ddbc5",
      "migrations_dir": "migrations"
    }
  ],

  // 교사·학생 화면. Vite 가 만든 결과물을 **같은 출처**에서 서빙한다 —
  // 다른 출처면 소켓·API 가 교차 출처 문제를 만들고, 학교망 프록시가 그걸 자주 막는다.
  //
  // ⚠️ `npm run build` 를 하지 않으면 dist/client 가 없어서 wrangler 가 뜨지 않는다.
  //    그래서 `npm run dev` 는 build 를 먼저 돌린다 (package.json).
  //
  // run_worker_first: 이 둘만 Worker 가 먼저 본다. 나머지는 정적 자산이 먼저다.
  //   ⚠️ `/api/*` 를 빼면 dist/client 에 없는 API 경로가 자산 404 로 끝나고,
  //      화면은 봉투 대신 HTML 을 받아 "서버 응답을 읽지 못했어요" 만 뜬다.
  // html_handling: /teacher → teacher.html. (Worker 에도 같은 처리를 남겨 뒀다 —
  //   src/server/index.ts 주석 참조)
  // not_found_handling: none — 없는 경로는 Worker 로 넘어가고, Worker 가 답한다
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  "observability": { "enabled": true }
}
