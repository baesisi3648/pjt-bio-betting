{
  // src/ — Cloudflare Workers 런타임에서 도는 코드.
  //
  // ⚠️ @cloudflare/workers-types 와 @types/node 는 같은 이름(fetch, Request, WebSocket …)을
  //    서로 다르게 선언해서 한 프로그램에 섞으면 충돌한다.
  //    그래서 tsconfig 를 둘로 나눴다 — 테스트는 tsconfig.test.json 이 본다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // ⚠️ src/client/** 은 여기서 뺀다. 화면은 브라우저에서 돌고 DOM 을 쓰므로
  //    Workers 타입으로 검사하면 document·window 가 전부 "Cannot find name" 이 된다.
  //    화면은 tsconfig.client.json 이 본다 (tsconfig 가 셋인 이유는 위 주석과 같다).
  "include": ["src/**/*.ts"],
  "exclude": ["src/client/**"]
}
